{
    "name": "apollo/apollo-seo",
    "description": "Apollo SEO — SEO metadata, Open Graph, JSON-LD, and sitemaps for the Apollo ecosystem",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Apollo\\SEO\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
