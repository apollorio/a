		</p>
		<p>
			<label>📄 <?php esc_html_e( 'Rider Técnico (URL)', 'apollo-djs' ); ?></label>
			<input type="url" name="_dj_rider_url" value="<?php echo esc_attr( (string) $rider ); ?>" class="widefat" placeholder="https://...">
