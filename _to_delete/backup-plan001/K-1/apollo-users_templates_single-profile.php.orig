<?php

/**
 * Single Profile Template - /id/{username}
 *
 * Renders the user profile page from a pre-built context array.
 * All DB reads happen in apollo_get_profile_context() — this template only displays.
 *
 * @package Apollo\Users
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

global $apollo_profile_user;

if ( ! $apollo_profile_user instanceof \WP_User || $apollo_profile_user->ID <= 0 ) {
	global $wp_query;
	$wp_query->set_404();
	status_header( 404 );
	if ( function_exists( 'get_template_part' ) ) {
		get_template_part( '404' );
	} else {
		echo '<h1>404 - User<font style="font-family:system-ui; font-size:110%">::</font>rio nao encontrado</h1>';
	}
	return;
}

// ─── Build context (single source of truth) ───
$ctx = \Apollo\Users\apollo_get_profile_context( $apollo_profile_user->ID );
if ( null === $ctx ) {
	status_header( 404 );
	return;
}

// Privacy gates (redirect to sub-templates before any output)
if ( $ctx['privacy'] === 'private' && ! $ctx['is_own'] && ! $ctx['is_admin'] ) {
	include APOLLO_USERS_DIR . 'templates/profile-private.php';
	return;
}
if ( $ctx['privacy'] === 'members' && ! $ctx['is_logged_in'] ) {
	include APOLLO_USERS_DIR . 'templates/profile-login-required.php';
	return;
}

// Record profile view (side-effect already handled inside context builder)

// ─── Extract display-only variables for the template below ───
$user_id           = $ctx['user_id'];
$is_own            = $ctx['is_own'];
$is_logged_in      = $ctx['is_logged_in'];
$is_admin          = $ctx['is_admin'];
$display_name      = $ctx['display_name'];
$bio               = $ctx['bio'];
$avatar_url        = $ctx['avatar_url'];
$member_since      = $ctx['member_since'];
$membership        = $ctx['membership'];
$has_membership    = ! empty( $ctx['membership']['type'] ) && $ctx['membership']['type'] !== 'nao-verificado';
$youtube_embed     = $ctx['youtube_embed'];
$soundcloud_url    = $ctx['soundcloud_url'];
$soundcloud_widget = $ctx['soundcloud_widget'];
$sound_tags        = $ctx['sound_tags'];
$profile_link      = $ctx['profile_link'];
$profile_link_label = $ctx['profile_link_label'];
$tag_items         = array();
$fav_count         = $ctx['stats']['fav_count'];
$profile_views     = $ctx['stats']['profile_views'];
$hits_display      = $ctx['stats']['hits_display'];
$ranking_display   = $ctx['stats']['ranking_display'];
$rate_display      = '0.0';
$rating_averages   = $ctx['rating_averages'];
$rating_counts     = $ctx['rating_counts'];
$user_votes        = $ctx['user_votes'];
$confiavel_count   = $ctx['confiavel']['count'];
$confiavel_avatars = $ctx['confiavel']['avatars'];
$confiavel_display = $ctx['confiavel']['display'];
$user_posts        = $ctx['feed_posts'];
$depoimentos       = $ctx['depoimentos'];

// Admin-only rating data — never reaches non-admin scope
$sexy_count    = 0;
$sexy_avatars  = array();
$sexy_display  = '0';
$legal_count   = 0;
$legal_avatars = array();
$legal_display = '0';
if ( $is_admin && ! empty( $ctx['admin_ratings'] ) ) {
	$sexy_count    = $ctx['admin_ratings']['sexy']['count'] ?? 0;
	$sexy_avatars  = $ctx['admin_ratings']['sexy']['avatars'] ?? array();
	$sexy_display  = $ctx['admin_ratings']['sexy']['display'] ?? '0';
	$legal_count   = $ctx['admin_ratings']['legal']['count'] ?? 0;
	$legal_avatars = $ctx['admin_ratings']['legal']['avatars'] ?? array();
	$legal_display = $ctx['admin_ratings']['legal']['display'] ?? '0';
}

$membership_value = $ctx['membership']['type'] ?? '';
$current_user_id  = get_current_user_id();

ob_start();
?>
	<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
	<script src="https://w.soundcloud.com/player/api.js"></script>
	<?php if (defined('APOLLO_TEMPLATES_URL') && defined('APOLLO_TEMPLATES_VERSION')) : ?>
		<link rel="stylesheet"
			href="<?php echo esc_url(APOLLO_TEMPLATES_URL . 'assets/css/navbar.v2.css'); ?>?v=<?php echo esc_attr(APOLLO_TEMPLATES_VERSION); ?>">
		<script
			src="<?php echo esc_url(APOLLO_TEMPLATES_URL . 'assets/js/navbar.v2.js'); ?>?v=<?php echo esc_attr(APOLLO_TEMPLATES_VERSION); ?>"
			defer></script>
	<?php endif; ?>
	<style>
		/* ── Bridge: Apollo CDN → --s-N; template aliases → --space-N / --radius-* ── */
		:root {
			/* Spacing */
			--space-1:  4px;
			--space-2:  8px;
			--space-3: 16px;
			--space-4: 24px;
			--space-5: 40px;
			--space-6: 64px;
			/* Radius */
			--r-xs:  8px;
			--r-sm: 14px;
			--radius-md: 20px;
			--r-lg: 28px;
			--radius-xl: 36px;
			/* Easing */
			--ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
			--transition-ui: 0.28s cubic-bezier(0.16, 1, 0.3, 1);
			/* Surfaces */
			--surface-0: #ffffff;
			--surface-1: #f7f7f7;
			--surface-2: #efefef;
			/* Ink */
			--ink:        #0a0a0a;
			--ink-muted:  rgba(10, 10, 10, 0.42);
			--ink-faint:  rgba(10, 10, 10, 0.07);
			/* Brand */
			--brand: var(--primary, FF9820);
			/* Layout */
			--page-gutter: 16px;
			--container-max: 1320px;
			/* Separator */
			--sep: rgba(var(--rgb-d), 0.06);
			/* ── Compat aliases (orphaned CSS block uses these legacy names) ── */
			--border:       rgba(var(--rgb-d), 0.06);
			--gray-1:       #f7f7f7;
			--gray-2:       #efefef;
			--gray-5:       rgba(var(--rgb-t), 0.5);
			--gray-9:       #555555;
			--black-1:      #0a0a0a;
			--ease-smooth:  cubic-bezier(0.16, 1, 0.3, 1);
			--ease-default: cubic-bezier(0.16, 1, 0.3, 1);
			--txt-muted:    rgba(10, 10, 10, 0.42);
			--primary:      FF9820;
			--radius:       var(--radius-md);
		}

		/* ══════════════════════════════════════════════════════════
		   APOLLO PROFILE — EXTREME LUXURY MINIMALIST
		   Surface: #fff | Accent: var(--primary, FF9820)
		   ══════════════════════════════════════════════════════════ */

		/* ── Keyframes ── */
		@keyframes fadeUp   { from { opacity: 0; transform: translateY(28px); }   to { opacity: 1; transform: translateY(0); } }
		@keyframes fadeIn   { from { opacity: 0; }                                  to { opacity: 1; } }
		@keyframes scaleIn  { from { opacity: 0; transform: scale(0.95); }          to { opacity: 1; transform: scale(1); } }
		@keyframes slideUp  { from { opacity: 0; transform: translateY(100%); }     to { opacity: 1; transform: translateY(0); } }
		@keyframes pulseGlow {
			0%, 100% { box-shadow: 0 0 0 0 rgba(var(--rgb-d), 0); }
			50%       { box-shadow: 0 0 18px 4px rgba(var(--rgb-d), 0.04); }
		}
		@keyframes breathe {
			0%, 100% { opacity: 0.10; }
			50%       { opacity: 0.26; }
		}

		/* ── Reset ── */
		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
		html { scroll-behavior: smooth; text-size-adjust: 100%; }

		body {
			background: var(--surface-0, #fff);
			color: var(--txt-color, #1a1a1a);
			font-family: var(--ff-main, system-ui, -apple-system, sans-serif);
			font-size: 15px;
			line-height: 1.55;
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			overflow-x: hidden;
			padding-bottom: env(safe-area-inset-bottom, 24px);
		}

		/* ════════════════ NAVBAR v2 COMPAT ════════════════ */
		/* Navbar is floating pill — no padding-top needed */

		a {
			color: inherit;
			text-decoration: none;
			transition: color var(--transition-ui, 0.28s);
		}

		img { display: block; max-width: 100%; height: auto; }

		.no-sel { -webkit-user-select: none; user-select: none; }

		/* ── Container ── */
		.container {
			width: 100%;
			padding: 0 var(--page-gutter, 16px);
			margin: 0 auto;
		}

		/* ════════════════ HERO ════════════════ */
		.hero {
			position: relative;
			padding: 0 0 var(--space-4, 24px);
			animation: fadeIn 0.7s var(--ease-expo, ease) both;
		}

		.hero-media {
			width: 100%;
			height: 280px;
			border-radius: 0 0 var(--radius-xl, 36px) var(--radius-xl, 36px);
			overflow: hidden;
			position: relative;
			background: #0a0a0a;
			margin-bottom: -130px;
		}

		.hero-media iframe {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 130%;
			height: 130%;
			transform: translate(-50%, -50%);
			border: none;
			pointer-events: none;
			opacity: 0.7;
		}

		.hero-media::after {
			content: '';
			position: absolute;
			inset: 0;
			background:
				linear-gradient(to bottom, rgba(var(--rgb-d), 0.05) 0%, rgba(var(--rgb-d), 0.55) 100%),
				radial-gradient(ellipse at 20% 60%, rgba(244, 95, 0, 0.08) 0%, transparent 55%);
			animation: breathe 9s ease-in-out infinite;
			pointer-events: none;
			z-index: 1;
		}

		/* ════════════════ PROFILE CARD ════════════════ */
		.profile-card {
			background: var(--surface-0, #fff);
			border-radius: var(--radius-xl, 36px);
			border: 1px solid rgba(var(--rgb-d), 0.04);
			padding: var(--space-4, 24px);
			display: flex;
			flex-direction: column;
			gap: var(--space-3, 16px);
			box-shadow:
				0 2px 4px -1px rgba(var(--rgb-d), 0.02),
				0 24px 64px -20px rgba(var(--rgb-d), 0.08);
			position: relative;
			animation: fadeUp 0.9s var(--ease-expo, ease) 0.05s both;
		}

		/* Profile Controls */
		.profile-controls {
			position: absolute;
			top: var(--space-3, 16px);
			right: var(--space-3, 16px);
			display: flex;
			gap: 6px;
			z-index: 10;
		}

		.profile-control-btn {
			width: 34px;
			height: 34px;
			border-radius: 50%;
			background: var(--surface-1, #f7f7f7);
			border: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			font-size: 15px;
			color: var(--gray-9, #555);
			transition: all var(--transition-ui);
		}

		.profile-control-btn:hover {
			background: var(--ink, #0a0a0a);
			color: #fff;
			border-color: transparent;
			transform: translateY(-2px);
		}

		/* ── Avatar / Header ── */
		.profile-header {
			display: flex;
			gap: 14px;
			align-items: flex-end;
		}

		.avatar {
			width: 100px;
			height: 100px;
			flex-shrink: 0;
			border-radius: 20px;
			border: 3px solid var(--surface-0, #fff);
			object-fit: cover;
			background: var(--surface-2, #efefef);
			box-shadow:
				0 0 0 1px rgba(var(--rgb-d), 0.06),
				0 12px 32px -8px rgba(var(--rgb-d), 0.14);
			margin-top: -48px;
			transition: transform 0.5s var(--ease-expo), box-shadow 0.5s var(--ease-expo);
			cursor: pointer;
		}

		.avatar:hover {
			transform: scale(1.07) rotate(-1.5deg);
			box-shadow:
				0 0 0 2.5px var(--brand, FF9820),
				0 20px 48px -12px rgba(var(--rgb-d), 0.18);
		}

		/* ── Identity ── */
		.profile-identity {
			flex: 1;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 4px;
			padding-bottom: 2px;
		}

		.name {
			font-size: clamp(26px, 8.5vw, 42px);
			font-weight: 900;
			line-height: 1;
			color: var(--black-1, #0a0a0a);
			letter-spacing: -0.04em;
			word-break: break-word;
		}

		.user-membership-badge i {
			font-size: 1.45rem;
			vertical-align: -2px;
			color: rgba(var(--rgb-d), 0.22);
			mix-blend-mode: multiply;
		}

		.handle {
			font-size: 12.5px;
			font-weight: 500;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			cursor: pointer;
			transition: color var(--transition-ui);
			line-height: 1.5;
		}

		.handle:hover { color: var(--brand, FF9820); }

		/* ── Tags ── */
		.tags, .sound-preferences {
			display: flex;
			gap: 6px;
			flex-wrap: wrap;
		}

		.tag {
			font-family: var(--ff-mono, monospace);
			font-size: 0.68rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			padding: 4px 11px;
			border-radius: 999px;
			border: 1.5px solid rgba(var(--rgb-d), 0.09);
			color: var(--ink-muted, rgba(10, 10, 10, 0.45));
			background: transparent;
			transition: all 0.32s var(--ease-expo);
			cursor: crosshair;
		}

		.tag:hover {
			background: var(--ink, #0a0a0a);
			color: #fff;
			border-color: var(--ink, #0a0a0a);
			transform: translateY(-2px);
		}

		/* ── Bio ── */
		.bio {
			font-size: 14px;
			font-weight: 400;
			line-height: 1.68;
			color: var(--txt-color, #333);
		}

		/* ── Link ── */
		.link {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			font-size: 13px;
			font-weight: 600;
			color: var(--brand, FF9820);
			letter-spacing: 0.01em;
			transition: gap var(--transition-ui);
		}

		.link i { font-size: 14px; }
		.link:hover { gap: 8px; }

		/* ── Member badge ── */
		.member-badge {
			font-family: var(--ff-mono, monospace);
			font-size: 0.67rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.16em;
			color: rgba(var(--rgb-d), 0.22);
			text-align: center;
			padding-top: var(--space-2, 8px);
		}

		/* ════════════════ SOUNDCLOUD PLAYER ════════════════ */
		.player-section {
			border-top: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			padding-top: var(--space-3, 16px);
		}

		.player-card { position: relative; }

		.player-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 10px;
		}

		.player-logo {
			font-size: 24px;
			opacity: 0.2;
			color: var(--black-1, #0a0a0a);
			transition: opacity 0.35s, transform 0.45s var(--ease-expo);
		}

		.player-logo:hover { opacity: 0.5; transform: rotate(-8deg) scale(1.1); }

		.player-content {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 12px;
		}

		.track-info h4 {
			font-size: 14px;
			font-weight: 700;
			letter-spacing: -0.015em;
			color: var(--black-1, #0a0a0a);
			margin-bottom: 2px;
		}

		.track-info p { font-size: 11.5px; color: var(--txt-muted, #888); margin: 0; }

		.play-button {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			background: var(--surface-0, #fff);
			border: 1.5px solid var(--sep, rgba(var(--rgb-d), 0.06));
			box-shadow: 0 6px 20px -6px rgba(var(--rgb-d), 0.10);
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			flex-shrink: 0;
			transition: all 0.4s var(--ease-expo);
		}

		.play-button:hover {
			background: var(--ink, #0a0a0a);
			border-color: var(--ink, #0a0a0a);
			transform: scale(1.1);
			box-shadow: 0 10px 28px -8px rgba(var(--rgb-d), 0.18);
		}

		.play-button:hover .material-symbols-outlined { color: #fff; }
		.play-button:active { transform: scale(0.95); }
		.play-button.is-playing { animation: pulseGlow 2s ease-in-out infinite; }
		.play-button .material-symbols-outlined { font-size: 24px; color: var(--black-1, #0a0a0a); }

		/* Progress bar */
		.progress-bar { display: flex; align-items: center; gap: 10px; }

		.progress-track {
			flex: 1;
			height: 3px;
			background: rgba(var(--rgb-d), 0.06);
			border-radius: 100px;
			position: relative;
			cursor: pointer;
			overflow: hidden;
			transition: height 0.2s;
		}

		.progress-track:hover { height: 5px; }

		.progress-fill {
			position: absolute;
			left: 0;
			top: 0;
			height: 100%;
			width: 0%;
			background: linear-gradient(90deg, var(--brand, FF9820), #ff914c);
			border-radius: 100px;
			transition: width 0.4s linear;
		}

		.progress-time {
			font-family: var(--ff-mono, monospace);
			font-size: 10px;
			font-weight: 700;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			min-width: 36px;
			text-align: right;
			font-variant-numeric: tabular-nums;
		}

		#sc-widget {
			position: absolute;
			width: 1px;
			height: 1px;
			opacity: 0;
			pointer-events: none;
		}

		/* ════════════════ STATS SECTION ════════════════ */
		.stats-section {
			margin-top: var(--space-3, 16px);
			display: flex;
			flex-direction: column;
			gap: 8px;
			animation: fadeUp 0.9s var(--ease-expo, ease) 0.18s both;
		}

		.stat-card {
			background: var(--surface-0, #fff);
			border-radius: var(--r-lg, 28px);
			border: 1px solid rgba(var(--rgb-d), 0.04);
			padding: var(--space-3, 16px);
			box-shadow: 0 2px 12px -4px rgba(var(--rgb-d), 0.04);
			transition: transform 0.4s var(--ease-expo), box-shadow 0.4s var(--ease-expo);
		}

		.stat-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 12px 32px -10px rgba(var(--rgb-d), 0.07);
		}

		.stat-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 14px;
		}

		.stat-title {
			display: flex;
			align-items: center;
			gap: 6px;
			font-family: var(--ff-mono, monospace);
			font-size: 0.68rem;
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		.stat-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 6px;
		}

		.stat-item {
			padding: 13px 10px;
			border-radius: var(--r-sm, 14px);
			background: var(--surface-1, #f7f7f7);
			text-align: center;
			transition: all 0.35s var(--ease-expo);
			cursor: default;
		}

		.stat-item:hover { background: var(--ink, #0a0a0a); transform: translateY(-2px); }
		.stat-item:hover .stat-label,
		.stat-item:hover .stat-value { color: #fff; }

		.stat-label {
			display: block;
			font-size: 9.5px;
			font-family: var(--ff-mono, monospace);
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			margin-bottom: 4px;
			transition: color 0.28s;
		}

		.stat-value {
			font-size: 1.38rem;
			font-weight: 900;
			letter-spacing: -0.03em;
			color: var(--black-1, #0a0a0a);
			font-variant-numeric: tabular-nums;
			transition: color 0.28s;
		}

		/* ════════════════ RATINGS ════════════════ */
		.ratings-content {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-2, 8px);
		}

		.rating-column {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 6px;
		}

		.rating-column:nth-child(2),
		.rating-column:nth-child(3) { flex-direction: column-reverse; }

		.rating-label {
			font-family: var(--ff-mono, monospace);
			font-size: 0.64rem;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			text-align: center;
		}

		.rating-icons { display: flex; gap: 4px; justify-content: center; margin-bottom: 4px; }

		.rating-icon {
			font-size: 23px;
			color: var(--black-1, #0a0a0a);
			opacity: 0.18;
			cursor: pointer;
			transition: all 0.4s var(--ease-expo);
			filter: grayscale(100%);
		}

		.rating-icon:hover { opacity: 0.55; transform: scale(1.25); filter: grayscale(0%); }
		.rating-icon.filled { opacity: 1; filter: grayscale(0%); }
		.rating-icon.filled:hover { transform: scale(1.12) rotate(-5deg); }

		/* ── Confiável public section ── */
		.confiavel-section {
			margin-top: 14px;
			padding-top: 12px;
			border-top: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
		}

		.confiavel-trigger {
			display: block;
			text-decoration: none;
			color: inherit;
			cursor: pointer;
			transition: opacity 0.28s;
		}

		.confiavel-trigger:hover { opacity: 0.75; }

		.confiavel-meta {
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.confiavel-avatars { display: flex; align-items: center; }

		.confiavel-avatars .av {
			width: 28px;
			height: 28px;
			border-radius: 50%;
			border: 2px solid var(--surface-0, #fff);
			margin-right: -8px;
			overflow: hidden;
			flex-shrink: 0;
			box-shadow: 0 0 0 1px rgba(var(--rgb-d), 0.08);
		}

		.confiavel-avatars .av img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			filter: grayscale(80%);
			transition: filter 0.4s;
		}

		.confiavel-trigger:hover .confiavel-avatars .av img { filter: grayscale(0%); }

		.confiavel-avatars .av-empty {
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--surface-2, #efefef);
			color: var(--ink-muted);
			font-size: 13px;
		}

		.confiavel-stat {
			font-family: var(--ff-mono, monospace);
			font-size: 11px;
			font-weight: 600;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			display: flex;
			align-items: center;
			gap: 4px;
		}

		.confiavel-stat i { font-size: 13px; }

		/* ── Admin summary ── */
		.rating-admin-summary {
			margin-top: 14px;
			padding-top: 12px;
			border-top: 1px dashed rgba(244, 95, 0, 0.22);
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.admin-badge {
			font-family: var(--ff-mono, monospace);
			font-size: 9px;
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--brand, FF9820);
			display: flex;
			align-items: center;
			gap: 4px;
		}

		.admin-rating-row {
			padding: 8px 10px;
			border-radius: var(--r-sm, 14px);
			background: var(--surface-1, #f7f7f7);
			transition: background 0.25s;
		}

		.admin-rating-row:hover { background: rgba(244, 95, 0, 0.06); }

		/* ── Publications ── */
		.pub-list { display: flex; flex-direction: column; }

		.pub-item {
			display: block;
			padding: 11px 0;
			border-bottom: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			transition: padding-left 0.28s var(--ease-expo);
		}

		.pub-item:last-child { border-bottom: none; }
		.pub-item:hover { padding-left: 6px; }
		.pub-item:hover .pub-title { color: var(--brand, FF9820); }

		.pub-title {
			font-size: 13.5px;
			font-weight: 700;
			color: var(--black-1, #0a0a0a);
			margin-bottom: 2px;
			transition: color 0.25s;
		}

		.pub-meta {
			font-family: var(--ff-mono, monospace);
			font-size: 10.5px;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		/* ════════════════ VOTER LIST MODAL ════════════════ */
		.voter-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(var(--rgb-d), 0.12);
			backdrop-filter: blur(10px) grayscale(70%);
			z-index: 9999999;
			justify-content: center;
			align-items: flex-end;
		}

		.voter-modal.active { display: flex; }

		.voter-modal-content {
			background: var(--surface-0, #fff);
			border-radius: var(--radius-xl, 36px) var(--radius-xl, 36px) 0 0;
			padding: var(--space-4, 24px) var(--space-3, 16px) calc(var(--space-4, 24px) + env(safe-area-inset-bottom, 0px));
			max-width: 520px;
			width: 100%;
			max-height: 82vh;
			overflow-y: auto;
			box-shadow: 0 -24px 64px -16px rgba(var(--rgb-d), 0.10);
			animation: slideUp 0.36s var(--ease-expo, ease) both;
		}

		.voter-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: var(--space-3, 16px);
		}

		.voter-modal-title {
			font-size: 17px;
			font-weight: 900;
			letter-spacing: -0.02em;
			color: var(--black-1, #0a0a0a);
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.voter-modal-title i { font-size: 20px; }

		.voter-modal-close {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--surface-2, #efefef);
			border: none;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			font-size: 17px;
			transition: all 0.25s;
		}

		.voter-modal-close:hover { background: var(--ink, #0a0a0a); color: #fff; }

		.voter-modal-count {
			font-family: var(--ff-mono, monospace);
			font-size: 11px;
			font-weight: 600;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			margin-bottom: var(--space-3, 16px);
			padding-bottom: 10px;
			border-bottom: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
		}

		.voter-list { display: flex; flex-direction: column; }

		.voter-item {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 11px 8px;
			border-bottom: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			text-decoration: none;
			color: inherit;
			transition: background 0.2s;
		}

		.voter-item:hover { background: var(--surface-1, #f7f7f7); }
		.voter-item:last-child { border-bottom: none; }

		.voter-avatar {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			object-fit: cover;
			border: 2px solid var(--sep, rgba(var(--rgb-d), 0.06));
			flex-shrink: 0;
			filter: grayscale(30%);
			transition: filter 0.3s;
		}

		.voter-item:hover .voter-avatar { filter: grayscale(0%); }

		.voter-info { flex: 1; min-width: 0; }

		.voter-name {
			font-size: 13px;
			font-weight: 700;
			color: var(--black-1, #0a0a0a);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.voter-timestamp {
			font-family: var(--ff-mono, monospace);
			font-size: 10px;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		.voter-score { display: flex; gap: 3px; flex-shrink: 0; }
		.voter-score i { font-size: 14px; opacity: 0.2; }
		.voter-score i.active { opacity: 1; color: var(--brand, FF9820); }

		.voter-empty {
			text-align: center;
			padding: 40px 20px;
			font-family: var(--ff-mono, monospace);
			font-size: 12px;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		.voter-load-more {
			display: block;
			width: 100%;
			padding: 13px;
			margin-top: 10px;
			background: var(--surface-1, #f7f7f7);
			border: none;
			border-radius: var(--r-sm, 14px);
			font-family: var(--ff-mono, monospace);
			font-size: 11px;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			color: var(--black-1, #0a0a0a);
			cursor: pointer;
			transition: all 0.25s;
		}

		.voter-load-more:hover { background: var(--ink, #0a0a0a); color: #fff; }

		/* Admin accordion */
		.admin-accordion-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 11px 0;
			cursor: pointer;
			border-bottom: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			transition: opacity 0.2s;
		}

		.admin-accordion-header:hover { opacity: 0.65; }

		.admin-accordion-header .acc-label {
			font-family: var(--ff-mono, monospace);
			font-size: 12px;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.admin-accordion-header .acc-arrow { font-size: 15px; transition: transform 0.3s; }
		.admin-accordion-header.open .acc-arrow { transform: rotate(180deg); }
		.admin-accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.4s var(--ease-expo, ease); }
		.admin-accordion-body.open { max-height: 2000px; }

		.voter-report-btn {
			margin-left: auto;
			background: none;
			border: none;
			cursor: pointer;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			font-size: 14px;
			padding: 4px 6px;
			border-radius: var(--r-xs, 8px);
			transition: all 0.2s;
			opacity: 0;
			flex-shrink: 0;
		}

		.voter-item:hover .voter-report-btn { opacity: 1; }
		.voter-report-btn:hover { color: #ef4444; background: rgba(239, 68, 68, 0.08); }

		/* ════════════════ PUB/FEED SECTION ════════════════ */
		.feed-section {
			margin-top: var(--space-6, 64px);
			animation: fadeUp 0.9s var(--ease-expo, ease) 0.35s both;
		}

		.feed-tabs {
			display: flex;
			gap: 6px;
			margin-bottom: var(--space-4, 24px);
			padding-bottom: var(--space-3, 16px);
			border-bottom: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.feed-tabs::-webkit-scrollbar { display: none; }

		.feed-tab {
			padding: 9px 18px;
			font-family: var(--ff-mono, monospace);
			font-size: 0.68rem;
			font-weight: 900;
			letter-spacing: 0.07em;
			text-transform: uppercase;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			border-radius: 999px;
			border: 1.5px solid transparent;
			background: transparent;
			cursor: pointer;
			transition: all 0.28s var(--ease-expo);
			white-space: nowrap;
			flex-shrink: 0;
		}

		.feed-tab:hover { background: var(--surface-1, #f7f7f7); color: var(--black-1, #0a0a0a); }
		.feed-tab.active { background: var(--ink, #0a0a0a); color: #fff; border-color: var(--ink, #0a0a0a); }

		.feed-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: var(--space-3, 16px);
			margin-bottom: var(--space-5, 40px);
		}

		.feed-card {
			background: var(--surface-0, #fff);
			border: 1px solid rgba(var(--rgb-d), 0.05);
			border-radius: var(--r-lg, 28px);
			overflow: hidden;
			position: relative;
			cursor: pointer;
			transition: transform 0.45s var(--ease-expo), box-shadow 0.45s var(--ease-expo), border-color 0.3s;
			box-shadow: 0 4px 20px -8px rgba(var(--rgb-d), 0.04);
		}

		.feed-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 20px 48px -16px rgba(var(--rgb-d), 0.10);
			border-color: rgba(var(--rgb-d), 0.10);
		}

		.feed-image {
			width: 100%;
			height: 185px;
			object-fit: cover;
			filter: grayscale(85%) contrast(1.04);
			transition: filter 0.5s var(--ease-expo), transform 0.5s var(--ease-expo);
			display: block;
		}

		.feed-card:hover .feed-image { filter: grayscale(0%); transform: scale(1.04); }

		.feed-body { padding: var(--space-4, 24px); }

		.feed-meta {
			font-family: var(--ff-mono, monospace);
			font-size: 0.66rem;
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.11em;
			color: var(--brand, FF9820);
			margin-bottom: 8px;
		}

		.feed-title {
			font-size: 17px;
			font-weight: 900;
			letter-spacing: -0.03em;
			line-height: 1.2;
			color: var(--black-1, #0a0a0a);
			margin-bottom: 8px;
		}

		.feed-text {
			font-size: 13px;
			line-height: 1.62;
			color: var(--txt-main, #444);
			margin-bottom: 12px;
		}

		.feed-reactions {
			display: flex;
			align-items: center;
			gap: var(--space-3, 16px);
			padding-top: 12px;
			border-top: 1px solid var(--sep, rgba(var(--rgb-d), 0.06));
		}

		.reaction-btn {
			display: flex;
			align-items: center;
			gap: 5px;
			font-family: var(--ff-mono, monospace);
			font-size: 11.5px;
			font-weight: 700;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			background: none;
			border: none;
			cursor: pointer;
			transition: all 0.26s;
		}

		.reaction-btn:hover { color: var(--brand, FF9820); transform: scale(1.06); }
		.reaction-btn i { font-size: 18px; }
		.reaction-btn.reacted { color: var(--brand, FF9820); }

		/* Dark feed cards */
		.feed-card.dark { background: var(--ink, #0a0a0a); border-color: transparent; }
		.feed-card.dark .feed-meta  { color: rgba(var(--rgb-t), 0.5); }
		.feed-card.dark .feed-title { color: #fff; }
		.feed-card.dark .feed-text  { color: rgba(var(--rgb-t), 0.5); }

		.playlist-visual {
			margin: var(--space-3, 16px) 0;
			background: rgba(var(--rgb-t), 0.07);
			padding: var(--space-3, 16px);
			border-radius: var(--r-sm, 14px);
			display: flex;
			align-items: center;
			gap: var(--space-3, 16px);
			transition: background 0.4s;
		}

		.playlist-visual:hover { background: rgba(var(--rgb-t), 0.12); }
		.playlist-visual i { font-size: 32px; color: #fff; transition: transform 0.4s var(--ease-expo); }
		.playlist-visual:hover i { transform: scale(1.12) rotate(-5deg); }

		.playlist-bar-container { height: 3px; flex: 1; background: rgba(var(--rgb-t), 0.18); position: relative; border-radius: 100px; overflow: hidden; }
		.playlist-bar-fill { width: 65%; height: 100%; background: linear-gradient(90deg, #fff, rgba(var(--rgb-t), 0.55)); position: absolute; border-radius: 100px; }

		/* ════════════════ TESTIMONIALS ════════════════ */
		.testimonials-section {
			margin: 60px 0 96px;
			animation: fadeUp 0.9s var(--ease-expo, ease) 0.5s both;
		}

		.section-divider {
			display: flex;
			align-items: center;
			gap: 16px;
			margin-bottom: var(--space-5, 40px);
		}

		.divider-line {
			flex: 1;
			height: 1px;
			background: linear-gradient(90deg, transparent, var(--sep, rgba(var(--rgb-d), 0.06)), transparent);
		}

		.divider-label {
			font-family: var(--ff-mono, monospace);
			font-size: 0.66rem;
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.24em;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			white-space: nowrap;
		}

		.testimonials-header { margin-bottom: var(--space-4, 24px); }

		.testimonials-title {
			font-size: clamp(26px, 7vw, 40px);
			font-weight: 900;
			letter-spacing: -0.04em;
			line-height: 1.05;
			color: var(--black-1, #0a0a0a);
			margin-bottom: var(--space-2, 8px);
		}

		.testimonials-subtitle {
			font-family: var(--ff-mono, monospace);
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		.testimonials-grid { display: flex; flex-direction: column; gap: 20px; }

		.testimonial-container {
			width: 100%;
			border-radius: var(--r-lg, 28px);
			background: var(--surface-1, #f7f7f7);
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: center;
			column-gap: 16px;
			padding: 20px;
			transition: transform 0.4s var(--ease-expo), box-shadow 0.4s var(--ease-expo);
		}

		.testimonial-container:hover {
			transform: translateY(-3px);
			box-shadow: 0 16px 40px -12px rgba(var(--rgb-d), 0.07);
		}

		.testimonial-img {
			width: 72px;
			height: 72px;
			border-radius: var(--r-sm, 14px);
			object-fit: cover;
			filter: grayscale(40%);
			transition: filter 0.4s, transform 0.4s var(--ease-expo);
		}

		.testimonial-container:hover .testimonial-img { filter: grayscale(0%); transform: scale(1.04); }

		.testimonial-content {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 8px;
		}

		.testimonial-copy {
			font-size: 13.5px;
			line-height: 1.65;
			color: var(--txt-color, #333);
			font-style: italic;
		}

		.testimonial-detail { display: flex; flex-direction: column; gap: 2px; }

		.testimonial-name {
			font-size: 13px;
			font-weight: 800;
			letter-spacing: -0.01em;
			color: var(--black-1, #0a0a0a);
		}

		.testimonial-post {
			font-family: var(--ff-mono, monospace);
			font-size: 10px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.09em;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		/* ════════════════ STATISTICS MODAL ════════════════ */
		.stats-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(var(--rgb-d), 0.12);
			backdrop-filter: blur(10px) grayscale(60%);
			z-index: 999999;
			justify-content: center;
			align-items: center;
		}

		.stats-modal.active { display: flex; }

		.stats-modal-content {
			background: var(--surface-0, #fff);
			border-radius: var(--radius-xl, 36px);
			padding: var(--space-4, 24px);
			max-width: 560px;
			width: 92%;
			box-shadow: 0 32px 80px -20px rgba(var(--rgb-d), 0.10);
			animation: scaleIn 0.32s var(--ease-expo, ease) both;
		}

		.stats-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: var(--space-3, 16px);
		}

		.stats-modal-title {
			font-size: 19px;
			font-weight: 900;
			letter-spacing: -0.03em;
			color: var(--black-1, #0a0a0a);
		}

		.stats-modal-close {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--surface-2, #efefef);
			border: none;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.25s;
		}

		.stats-modal-close:hover { background: var(--ink, #0a0a0a); color: #fff; }

		.stats-period-tabs { display: flex; gap: 6px; margin-bottom: var(--space-3, 16px); }

		.stats-period-tab {
			padding: 7px 14px;
			border-radius: var(--r-xs, 8px);
			font-family: var(--ff-mono, monospace);
			font-size: 10.5px;
			font-weight: 900;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			background: var(--surface-1, #f7f7f7);
			border: none;
			cursor: pointer;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			transition: all 0.25s;
		}

		.stats-period-tab.active { background: var(--ink, #0a0a0a); color: #fff; }

		.stats-chart-placeholder {
			width: 100%;
			height: 240px;
			background: var(--surface-1, #f7f7f7);
			border-radius: var(--radius-md, 20px);
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--ff-mono, monospace);
			font-size: 12px;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
		}

		/* ════════════════ CONFIÁVEL CONFIRM MODAL ════════════════ */
		.cv-confirm-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(var(--rgb-d), 0.16);
			backdrop-filter: blur(12px) grayscale(50%);
			-webkit-backdrop-filter: blur(12px) grayscale(50%);
			z-index: 9999999;
			justify-content: center;
			align-items: flex-end;
		}

		.cv-confirm-modal.active { display: flex; }

		.cv-confirm-content {
			background: var(--surface-0, #fff);
			border-radius: var(--radius-xl, 36px) var(--radius-xl, 36px) 0 0;
			padding: var(--space-4, 24px) var(--space-3, 16px) calc(var(--space-4, 24px) + env(safe-area-inset-bottom, 0px));
			max-width: 480px;
			width: 100%;
			box-shadow: 0 -28px 72px -20px rgba(var(--rgb-d), 0.12);
			animation: slideUp 0.4s var(--ease-expo, ease) both;
		}

		.cv-confirm-header {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: var(--space-3, 16px);
		}

		.cv-confirm-icon {
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: rgba(59, 130, 246, 0.1);
			display: flex;
			align-items: center;
			justify-content: center;
			color: #3b82f6;
			font-size: 21px;
			flex-shrink: 0;
		}

		.cv-confirm-title {
			font-size: 17px;
			font-weight: 900;
			letter-spacing: -0.025em;
			color: var(--black-1, #0a0a0a);
			margin: 0;
		}

		.cv-confirm-body {
			font-size: 14.5px;
			line-height: 1.62;
			color: var(--txt-color, #333);
			margin-bottom: var(--space-3, 16px);
		}

		.cv-confirm-warn {
			font-family: var(--ff-mono, monospace);
			font-size: 11px;
			color: var(--ink-muted, rgba(10, 10, 10, 0.42));
			display: flex;
			align-items: flex-start;
			gap: 6px;
			padding: 10px 12px;
			background: rgba(59, 130, 246, 0.05);
			border-radius: var(--r-sm, 14px);
			margin-bottom: var(--space-4, 24px);
			border-left: 3px solid rgba(59, 130, 246, 0.4);
			line-height: 1.55;
		}

		.cv-confirm-warn i { font-size: 13px; margin-top: 1px; flex-shrink: 0; color: #3b82f6; }

		.cv-confirm-actions { display: flex; gap: var(--space-2, 8px); }

		.cv-cancel-btn {
			flex: 1;
			padding: 13px;
			border-radius: var(--r-sm, 14px);
			font-size: 0.88rem;
			font-weight: 600;
			background: var(--surface-1, #f7f7f7);
			border: 1.5px solid var(--sep, rgba(var(--rgb-d), 0.06));
			color: var(--txt-color, #333);
			cursor: pointer;
			transition: background var(--transition-ui);
		}

		.cv-cancel-btn:hover { background: var(--surface-2, #efefef); }

		.cv-yes-btn {
			flex: 2;
			padding: 13px;
			border-radius: var(--r-sm, 14px);
			font-size: 0.88rem;
			font-weight: 800;
			background: var(--ink, #0a0a0a);
			color: #fff;
			border: none;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			transition: all var(--transition-ui);
		}

		.cv-yes-btn:hover { background: #000; transform: translateY(-1px); }
		.cv-yes-btn:active { transform: scale(0.97); }
		.cv-yes-btn.loading { opacity: 0.55; pointer-events: none; }

		/* ── Already voted ── */
		.rating-column[data-already-voted] .rating-icon { pointer-events: none; cursor: default; }

		/* ── More pill ── */
		.cv-more-pill {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: rgba(var(--rgb-d), 0.07);
			border: 2px solid var(--surface-0, #fff);
			margin-left: -8px;
			font-size: 10px;
			font-weight: 900;
			color: var(--txt-color, #333);
			flex-shrink: 0;
			letter-spacing: -0.02em;
		}

		.confiavel-avatars-btn { background: none; border: none; padding: 0; cursor: pointer; display: inline-flex; align-items: center; }
		.confiavel-avatars-btn:hover .cv-more-pill { background: var(--ink, #0a0a0a); color: #fff; }

		/* ════════════════ TOOLTIPS ════════════════ */
		[data-tooltip] { position: relative; }

		[data-tooltip]::before {
			content: attr(data-tooltip);
			position: absolute;
			bottom: calc(100% + 8px);
			left: 50%;
			transform: translateX(-50%) translateY(-4px);
			padding: 5px 12px;
			background: var(--ink, #0a0a0a);
			color: #fff;
			font-size: 11px;
			font-weight: 600;
			white-space: nowrap;
			border-radius: 6px;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease;
			z-index: 1000;
		}

		[data-tooltip]::after {
			content: "";
			position: absolute;
			bottom: calc(100% + 2px);
			left: 50%;
			transform: translateX(-50%);
			border: 5px solid transparent;
			border-top-color: var(--ink, #0a0a0a);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.2s ease;
			z-index: 1000;
		}

		[data-tooltip]:hover::before,
		[data-tooltip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

		/* ════════════════ DESKTOP 980px + ════════════════ */
		@media (min-width: 980px) {
			:root {
				--page-gutter: 32px;
			}

			body { padding-top: 0; }

			.container { max-width: var(--container-max, 1320px); }

			.hero-media {
				height: 460px;
				margin-bottom: -220px;
			}

			.hero-layout {
				display: grid;
				grid-template-columns: 1fr 360px;
				gap: 8px;
				position: relative;
				z-index: 10;
				align-items: start;
			}

			.profile-card { padding: var(--space-5, 40px); }

			.avatar {
				width: 140px;
				height: 140px;
				border-radius: 26px;
				margin-top: -62px;
			}

			.name { font-size: clamp(34px, 4.5vw, 52px); }

			.feed-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: var(--space-3, 16px);
			}

			.feed-image { height: 240px; }

			.testimonial-container { padding: 26px 30px; }

			.testimonial-img { width: 110px; height: 110px; }

			.testimonial-copy { font-size: 15px; }

			.voter-modal { align-items: center; }
			.voter-modal-content { border-radius: var(--radius-xl, 36px); max-height: 72vh; }

			.cv-confirm-content { border-radius: var(--radius-xl, 36px); }
			.cv-confirm-modal { align-items: center; }
		}

		@media (min-width: 1280px) {
			:root { --page-gutter: 48px; }

			.hero-layout {
				grid-template-columns: 1fr 400px;
				gap: var(--space-4, 24px);
			}

			.feed-grid { grid-template-columns: repeat(3, 1fr); }

			.hero-media { height: 520px; margin-bottom: -250px; }
		}

		.confiavel-avatars .av {
			width: 28px;
			height: 28px;
			border-radius: 50%;
			border: 2px solid rgba(var(--rgb-d), .8);
			margin-right: -8px;
			overflow: hidden;
			flex-shrink: 0;
		}

		.confiavel-avatars .av img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			filter: grayscale(100%);
			transition: filter 0.4s;
		}

		.confiavel-trigger:hover .confiavel-avatars .av img {
			filter: grayscale(0%);
		}

		.confiavel-avatars .av-empty {
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--gray-2);
			color: var(--gray-6);
			font-size: 14px;
		}

		.confiavel-stat {
			font-family: var(--ff-mono);
			font-size: 11px;
			color: rgba(var(--rgb-d), .45);
			display: flex;
			align-items: center;
			gap: 4px;
		}

		.confiavel-stat i {
			font-size: 13px;
		}

		/* ═══════════════════ ADMIN SUMMARY ROWS ═══════════════════ */
		.rating-admin-summary {
			margin-top: 14px;
			padding-top: 12px;
			border-top: 1px dashed rgba(244, 95, 0, 0.3);
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.admin-badge {
			font-family: var(--ff-mono);
			font-size: 9px;
			color: FF9820;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 700;
			display: flex;
			align-items: center;
			gap: 4px;
		}

		.admin-rating-row {
			padding: 6px 8px;
			border-radius: var(--r-sm);
			background: var(--gray-1);
			transition: background 0.3s;
		}

		.admin-rating-row:hover {
			background: rgba(244, 95, 0, 0.06);
		}

		/* ═══════════════════ VOTER LIST MODAL ═══════════════════ */
		.voter-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(140, 140, 140, 0.13);
			backdrop-filter: blur(6px) grayscale(100%);
			z-index: 9999999;
			justify-content: center;
			align-items: flex-end;
		}

		.voter-modal.active {
			display: flex;
		}

		.voter-modal-content {
			background: #fff;
			border-radius: var(--r-lg) var(--r-lg) 0 0;
			padding: var(--space-4) var(--space-4) var(--space-5);
			max-width: 480px;
			width: 100%;
			max-height: 80vh;
			overflow-y: auto;
			box-shadow: 0 -20px 60px -10px rgba(var(--rgb-d), 0.08);
			animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		}

		@keyframes slideUp {
			from {
				transform: translateY(100%);
				opacity: 0;
			}

			to {
				transform: translateY(0);
				opacity: 1;
			}
		}

		.voter-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: var(--space-3);
		}

		.voter-modal-title {
			font-size: 18px;
			font-weight: 700;
			color: var(--black-1);
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.voter-modal-title i {
			font-size: 20px;
		}

		.voter-modal-close {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--gray-1);
			border: none;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.3s;
			font-size: 18px;
		}

		.voter-modal-close:hover {
			background: var(--black-1);
			color: #fff;
		}

		.voter-modal-count {
			font-family: var(--ff-mono);
			font-size: 12px;
			color: var(--txt-muted);
			margin-bottom: var(--space-3);
			padding-bottom: 8px;
			border-bottom: 1px solid var(--border);
		}

		/* ═══ Voter Radar List ═══ */
		.voter-list {
			display: flex;
			flex-direction: column;
			gap: 0;
		}

		.voter-item {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 10px 8px;
			border-bottom: 1px solid var(--border);
			transition: background 0.2s;
			text-decoration: none;
			color: inherit;
		}

		.voter-item:hover {
			background: var(--gray-1);
		}

		.voter-item:last-child {
			border-bottom: none;
		}

		.voter-avatar {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			object-fit: cover;
			border: 2px solid var(--border);
			flex-shrink: 0;
			filter: grayscale(40%);
			transition: filter 0.3s;
		}

		.voter-item:hover .voter-avatar {
			filter: grayscale(0%);
		}

		.voter-info {
			flex: 1;
			min-width: 0;
		}

		.voter-name {
			font-size: 14px;
			font-weight: 600;
			color: var(--black-1);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.voter-timestamp {
			font-family: var(--ff-mono);
			font-size: 10px;
			color: var(--txt-muted);
			letter-spacing: 0.02em;
		}

		.voter-score {
			display: flex;
			gap: 3px;
			flex-shrink: 0;
		}

		.voter-score i {
			font-size: 14px;
			opacity: 0.25;
		}

		.voter-score i.active {
			opacity: 1;
			color: var(--primary, FF9820);
		}

		.voter-empty {
			text-align: center;
			padding: 40px 20px;
			color: var(--txt-muted);
			font-family: var(--ff-mono);
			font-size: 13px;
		}

		.voter-load-more {
			display: block;
			width: 100%;
			padding: 12px;
			margin-top: 8px;
			background: var(--gray-1);
			border: none;
			border-radius: var(--r-sm);
			font-family: var(--ff-mono);
			font-size: 12px;
			font-weight: 600;
			color: var(--black-1);
			cursor: pointer;
			transition: background 0.3s;
			text-align: center;
		}

		.voter-load-more:hover {
			background: var(--black-1);
			color: #fff;
		}

		/* ═══ Admin Accordion (Sexy/Legal voters) ═══ */
		.admin-accordion-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 10px 0;
			cursor: pointer;
			border-bottom: 1px solid var(--border);
			transition: opacity 0.2s;
		}

		.admin-accordion-header:hover {
			opacity: 0.7;
		}

		.admin-accordion-header .acc-label {
			font-family: var(--ff-mono);
			font-size: 13px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.admin-accordion-header .acc-arrow {
			font-size: 16px;
			transition: transform 0.3s;
		}

		.admin-accordion-header.open .acc-arrow {
			transform: rotate(180deg);
		}

		.admin-accordion-body {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		}

		.admin-accordion-body.open {
			max-height: 2000px;
		}

		@media (min-width: 980px) {
			.voter-modal {
				align-items: center;
			}

			.voter-modal-content {
				border-radius: var(--r-lg);
				max-height: 70vh;
			}
		}

		/* Publications - Clean Simple List */
		.pub-list {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

		.pub-item {
			display: block;
			padding: 10px 0;
			transition: all 0.3s var(--ease-smooth);
			border-bottom: 1px solid var(--border);
		}

		.pub-item:last-child {
			border-bottom: none;
		}

		.pub-item:hover {
			padding-left: 8px;
		}

		.pub-item:hover .pub-title {
			color: var(--primary);
		}

		.pub-title {
			font-size: 15px;
			font-weight: 700;
			color: var(--black-1);
			margin-bottom: 2px;
			transition: color 0.3s;
		}

		.pub-meta {
			font-size: 0.896rem;
			color: var(--txt-muted);
			font-family: var(--ff-mono);
		}

		/* ═══════════════════ FEED SECTION WITH TABS ═══════════════════ */
		.feed-section {
			margin-top: var(--space-6);
			animation: fadeUp 0.8s var(--ease-default) 0.4s both;
		}

		.feed-tabs {
			display: flex;
			gap: var(--space-2);
			margin-bottom: 28px;
			padding-bottom: var(--space-3);
			border-bottom: 1px solid var(--border);
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.feed-tabs::-webkit-scrollbar {
			display: none;
		}

		/* Tab: All Posts = All content posted by user */
		/* Tab: Events = Events favorited by user */
		/* Tab: Classifieds = Classified ads posted by user */
		.feed-tab {
			padding: 10px 18px;
			font-family: var(--ff-mono);
			font-size: 0.896rem;
			font-weight: 700;
			color: var(--txt-muted);
			border-radius: 100px;
			border: 1px solid transparent;
			background: transparent;
			cursor: pointer;
			transition: all 0.3s var(--ease-smooth);
			letter-spacing: 0.04em;
			white-space: nowrap;
			flex-shrink: 0;
		}

		.feed-tab:hover {
			background: var(--gray-1);
			color: var(--black-1);
		}

		.feed-tab.active {
			background: var(--black-1);
			color: #fff;
			border-color: var(--black-1);
		}

		.feed-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: var(--space-3);
			margin-bottom: var(--space-6);
		}

		/* Feed cards are clickable buttons that open post page */
		.feed-card {
			background: #fff;
			border: 1px solid var(--border);
			border-radius: var(--r-lg);
			overflow: hidden;
			position: relative;
			transition: all 0.5s var(--ease-smooth);
			box-shadow: 0 4px 16px -4px rgba(var(--rgb-d), 0.04);
			cursor: pointer;
		}

		.feed-card:hover {
			border-color: var(--black-1);
			transform: translateY(-6px);
			box-shadow: 0 24px 60px -16px rgba(var(--rgb-d), 0.05);
		}

		.feed-image {
			width: 100%;
			height: 200px;
			object-fit: cover;
			filter: grayscale(100%) contrast(1.05);
			transition: all 0.6s var(--ease-smooth);
		}

		.feed-card:hover .feed-image {
			filter: grayscale(0%);
			transform: scale(1.05);
		}

		.feed-body {
			padding: var(--space-4);
		}

		.feed-meta {
			font-family: var(--ff-mono);
			font-size: 0.75rem;
			color: var(--primary);
			text-transform: uppercase;
			font-weight: 700;
			margin-bottom: 10px;
			letter-spacing: 0.08em;
		}

		.feed-title {
			font-size: 20px;
			font-weight: 800;
			margin-bottom: 10px;
			color: var(--black-1);
			letter-spacing: -0.02em;
			line-height: 1.2;
		}

		.feed-text {
			font-size: 14px;
			color: var(--txt-main);
			line-height: 1.6;
			margin-bottom: 12px;
		}

		/* Reactions: wow and comments */
		.feed-reactions {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-top: 12px;
			padding-top: 12px;
			border-top: 1px solid var(--border);
		}

		.reaction-btn {
			display: flex;
			align-items: center;
			gap: 6px;
			font-family: var(--ff-mono);
			font-size: 14px;
			color: var(--gray-9);
			background: transparent;
			border: none;
			cursor: pointer;
			transition: all 0.3s var(--ease-smooth);
		}

		.reaction-btn:hover {
			color: var(--primary);
			transform: scale(1.05);
		}

		.reaction-btn i {
			font-size: 20px;
		}

		.reaction-btn.reacted {
			color: var(--primary);
		}

		.feed-card.dark {
			background: var(--black-1);
			border-color: var(--black-1);
		}

		.feed-card.dark .feed-meta {
			color: #fff;
		}

		.feed-card.dark .feed-title {
			color: #fff;
		}

		.feed-card.dark .feed-text {
			color: var(--gray-5);
		}

		.playlist-visual {
			margin: var(--space-3) 0;
			background: rgba(var(--rgb-t), 0.08);
			padding: var(--space-3);
			border-radius: var(--r-sm);
			display: flex;
			align-items: center;
			gap: var(--space-3);
			transition: background 0.4s;
		}

		.playlist-visual:hover {
			background: rgba(var(--rgb-t), 0.12);
		}

		.playlist-visual i {
			font-size: 36px;
			color: #fff;
			transition: transform 0.4s var(--ease-smooth);
		}

		.playlist-visual:hover i {
			transform: scale(1.15) rotate(-5deg);
		}

		.playlist-bar-container {
			height: 4px;
			flex: 1;
			background: rgba(var(--rgb-t), 0.2);
			position: relative;
			border-radius: 100px;
			overflow: hidden;
		}

		.playlist-bar-fill {
			width: 70%;
			height: 100%;
			background: linear-gradient(90deg, #fff, rgba(var(--rgb-t), 0.6));
			position: absolute;
			border-radius: 100px;
		}

		/* ═══════════════════ TESTIMONIALS - CLEAN MINIMALIST ═══════════════════ */
		.testimonials-section {
			margin: 64px 0 80px 0;
			animation: fadeUp 0.8s var(--ease-default) 0.6s both;
		}

		.section-divider {
			display: flex;
			align-items: center;
			gap: 4px;
			margin-bottom: var(--space-5);
		}

		.divider-line {
			flex: 1;
			height: 1px;
			background: linear-gradient(90deg, transparent, var(--border), transparent);
		}

		.divider-label {
			font-family: var(--ff-mono);
			font-size: 0.896rem;
			text-transform: uppercase;
			letter-spacing: 0.2em;
			color: var(--gray-8);
			white-space: nowrap;
			font-weight: 700;
		}

		.testimonials-header {
			margin-bottom: var(--space-5);
		}

		.testimonials-title {
			font-size: 32px;
			font-weight: 800;
			color: var(--black-1);
			letter-spacing: -0.03em;
			line-height: 1.1;
			margin-bottom: var(--space-2);
		}

		.testimonials-subtitle {
			font-family: var(--ff-mono);
			font-size: 0.896rem;
			color: var(--txt-muted);
			font-weight: 600;
		}

		.testimonials-grid {
			display: flex;
			flex-direction: column;
			gap: 32px;
		}

		/* Clean testimonial design - no borders */
		.testimonial-container {
			width: 100%;
			border-radius: 20px;
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: center;
			column-gap: 20px;
			padding: 24px;
			position: relative;
		}

		.testimonial-img {
			width: 145px;
			height: 145px;
			scale: 1.2;
			border-radius: 10px;
			object-fit: cover;
		}

		.testimonial-content {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			min-height: 100px;
			padding: 0 2rem;
		}

		.testimonial-copy {
			font-size: 1rem;
			line-height: 1.7;
			color: var(--black-1);
			margin-bottom: 16px;
		}

		.testimonial-detail {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.testimonial-name {
			font-size: 1rem;
			font-weight: 700;
			color: var(--black-1);
		}

		.testimonial-post {
			font-size: 0.896rem;
			color: #c1c1c1;
			font-family: var(--ff-mono);
		}

		/* Statistics Modal */
		.stats-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(140, 140, 140, 0.13);
			backdrop-filter: blur(6px) grayscale(100%);
			z-index: 999999;
			justify-content: center;
			align-items: center;
		}

		.stats-modal.active {
			display: flex;
		}

		.stats-modal-content {
			background: #fff;
			border-radius: var(--r-lg);
			padding: var(--space-5);
			max-width: 600px;
			width: 90%;
			box-shadow: 0 40px 80px -20px rgba(var(--rgb-d), 0.03);
		}

		.stats-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: var(--space-4);
		}

		.stats-modal-title {
			font-size: 24px;
			font-weight: 700;
			color: var(--black-1);
		}

		.stats-modal-close {
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: var(--gray-1);
			border: none;
			display: flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: all 0.3s;
		}

		.stats-modal-close:hover {
			background: var(--black-1);
			color: #fff;
		}

		.stats-period-tabs {
			display: flex;
			gap: 8px;
			margin-bottom: var(--space-4);
		}

		.stats-period-tab {
			padding: 8px 16px;
			border-radius: 8px;
			font-family: var(--ff-mono);
			font-size: 0.75rem;
			font-weight: 700;
			background: var(--gray-1);
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.stats-period-tab.active {
			background: var(--black-1);
			color: #fff;
		}

		.stats-chart-placeholder {
			width: 100%;
			height: 300px;
			background: var(--gray-1);
			border-radius: var(--r);
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--ff-mono);
			font-size: 14px;
			color: var(--txt-muted);
		}

		/* ═══════════════════ DESKTOP: 980px+ ═══════════════════ */
		@media (min-width: 980px) {
			body {
				padding-top: 4px;
			}

			.container {
				max-width: 1400px;
				padding: 0 var(--space-6);
			}

			.hero {
				padding: 0 0 var(--space-5) 0;
			}

			.hero-media {
				height: 500px;
				margin-bottom: -250px;
			}

			.hero-layout {
				display: grid;
				margin: 0 3% 0 2%;
				grid-template-columns: 1fr 380px;
				gap: 2px;
				position: relative;
				z-index: 10;
			}

			.profile-card {
				padding: 1.5rem;
				margin: 0 2px 0 3.5%;
			}

			.avatar {
				width: 140px;
				height: 140px;
			}

			.name {
				font-size: var(--fs-h2);
			}

			.feed-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 4px;
			}

			.feed-image {
				height: 280px;
			}

			.testimonial-container {
				padding: 32px 40px;
			}

			.testimonial-img {
				width: 160px;
				height: 160px;
			}

			.testimonial-copy {
				font-size: 1.17rem;
			}
		}

		@media (min-width: 1400px) {
			.container {
				max-width: 1600px;
			}

			.hero-layout {
				grid-template-columns: 1fr 420px;
				gap: var(--space-5);
			}

			.feed-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		/* ═════════════ CONFIÁVEL — CONFIRM MODAL ═════════════ */
		.cv-confirm-modal {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(var(--rgb-d), 0.18);
			backdrop-filter: blur(8px) grayscale(60%);
			-webkit-backdrop-filter: blur(8px) grayscale(60%);
			z-index: 9999999;
			justify-content: center;
			align-items: flex-end;
			padding: 0;
		}
		.cv-confirm-modal.active {
			display: flex;
		}
		.cv-confirm-content {
			background: #fff;
			border-radius: var(--r-lg) var(--r-lg) 0 0;
			padding: var(--space-5) var(--space-4) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
			max-width: 480px;
			width: 100%;
			box-shadow: 0 -24px 64px -16px rgba(var(--rgb-d), 0.1);
			animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.cv-confirm-header {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: var(--space-3);
		}
		.cv-confirm-icon {
			width: 44px;
			height: 44px;
			border-radius: 50%;
			background: rgba(59, 130, 246, 0.1);
			display: flex;
			align-items: center;
			justify-content: center;
			color: #3b82f6;
			font-size: 22px;
			flex-shrink: 0;
		}
		.cv-confirm-title {
			font-size: 18px;
			font-weight: 700;
			color: var(--black-1);
			letter-spacing: -0.02em;
			margin: 0;
		}
		.cv-confirm-body {
			font-size: 15px;
			line-height: 1.6;
			color: var(--txt-color);
			margin-bottom: var(--space-3);
		}
		.cv-confirm-warn {
			font-family: var(--ff-mono);
			font-size: 11px;
			color: var(--txt-muted);
			display: flex;
			align-items: flex-start;
			gap: 6px;
			padding: 10px 12px;
			background: rgba(var(--rgb-d), 0.03);
			border-radius: var(--r-sm);
			margin-bottom: var(--space-4);
			border-left: 3px solid rgba(59, 130, 246, 0.4);
		}
		.cv-confirm-warn i {
			font-size: 13px;
			margin-top: 1px;
			flex-shrink: 0;
			color: #3b82f6;
		}
		.cv-confirm-actions {
			display: flex;
			gap: var(--space-2);
		}
		.cv-cancel-btn {
			flex: 1;
			padding: 13px;
			border-radius: var(--r-sm);
			font-family: var(--ff-main);
			font-size: 0.9rem;
			font-weight: 600;
			background: rgba(var(--rgb-d), 0.06);
			border: 1px solid var(--border);
			color: var(--txt-color);
			cursor: pointer;
			transition: background var(--transition-ui);
		}
		.cv-cancel-btn:hover {
			background: rgba(var(--rgb-d), 0.1);
		}
		.cv-yes-btn {
			flex: 2;
			padding: 13px;
			border-radius: var(--r-sm);
			font-family: var(--ff-main);
			font-size: 0.9rem;
			font-weight: 700;
			background: var(--black-1);
			color: #fff;
			border: none;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			transition: all var(--transition-ui);
		}
		.cv-yes-btn:hover {
			background: #000;
			transform: translateY(-1px);
		}
		.cv-yes-btn:active { transform: scale(0.97); }
		.cv-yes-btn.loading { opacity: 0.6; pointer-events: none; }

		/* ─── Confiável already-voted permanent state ─── */
		.rating-column[data-already-voted] .rating-icon {
			pointer-events: none;
			cursor: default;
		}

		/* ─── Confiável avatar "···" more pill ─── */
		.cv-more-pill {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 28px;
			height: 28px;
			border-radius: 50%;
			background: rgba(var(--rgb-d), 0.08);
			border: 2px solid rgba(var(--rgb-t), 0.9);
			margin-left: -8px;
			font-size: 10px;
			color: var(--txt-color);
			font-weight: 700;
			letter-spacing: -0.02em;
			flex-shrink: 0;
		}
		.confiavel-avatars-btn {
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
		}
		.confiavel-avatars-btn:hover .cv-more-pill {
			background: var(--black-1);
			color: #fff;
		}

		/* ─── Report button inside voter list ─── */
		.voter-report-btn {
			margin-left: auto;
			background: none;
			border: none;
			cursor: pointer;
			color: var(--txt-muted);
			font-size: 14px;
			padding: 4px 6px;
			border-radius: var(--r-xs);
			transition: all 0.2s;
			opacity: 0;
			flex-shrink: 0;
		}
		.voter-item:hover .voter-report-btn {
			opacity: 1;
		}
		.voter-report-btn:hover {
			color: #ef4444;
			background: rgba(239, 68, 68, 0.08);
		}
		@media (min-width: 980px) {
			.cv-confirm-content {
				border-radius: var(--r-lg);
			}
			.cv-confirm-modal {
				align-items: center;
			}
		}

		/* ─── GLOBAL TOOLTIPS ──────────────────────────────────────────────── */
		[data-tooltip] {
			position: relative;
		}

		[data-tooltip]::before {
			content: attr(data-tooltip);
			position: absolute;
			bottom: calc(100% + 8px);
			left: 50%;
			transform: translateX(-50%) translateY(-4px);
			padding: 6px 12px;
			background: var(--ink);
			color: #fff;
			font-size: 12px;
			font-weight: 500;
			line-height: 1.4;
			white-space: nowrap;
			border-radius: 6px;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease;
			z-index: 1000;
		}

		[data-tooltip]::after {
			content: "";
			position: absolute;
			bottom: calc(100% + 2px);
			left: 50%;
			transform: translateX(-50%);
			border: 6px solid transparent;
			border-top-color: var(--ink);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.2s ease;
			z-index: 1000;
		}

		[data-tooltip]:hover::before,
		[data-tooltip]:hover::after {
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}

		/* Reduce heavy box/border feel without altering structure. */
		.profile-card,
		.stat-card,
		.feed-card,
		.depoimento-card {
			border-color: rgba(var(--rgb-d), 0.03) !important;
			box-shadow: 0 22px 48px -28px rgba(var(--rgb-d), 0.18) !important;
		}

		/* ── Safe area (iOS notch / home bar) ── */
		body {
			padding-left:  env(safe-area-inset-left, 0);
			padding-right: env(safe-area-inset-right, 0);
		}

		/* ── Reduced motion ── */
		@media (prefers-reduced-motion: reduce) {
			*, *::before, *::after {
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
				scroll-behavior: auto !important;
			}
		}
	</style>
