        }

        .cc-presets {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px
        }

        .cc-preset {
            padding: 6px 12px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: transparent;
            color: var(--muted);
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer
        }

        .cc-preset.is-on {
            background: var(--txt-heading);
            border-color: var(--txt-heading);
            color: var(--bg)
        }

        .cc-stepper {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .cc-step-btn {
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border);
            border-radius: 50%;
            background: transparent;
            color: var(--txt-heading);
            font-size: 16px;
            cursor: pointer
        }

        .cc-step-input {
            width: 70px;
            height: 36px;
            text-align: center;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg);
            color: var(--txt-heading);
            font-family: inherit;
            font-size: 15px;
            font-weight: 700
        }

        .cc-step-unit {
            font-size: 12px;
            color: var(--muted)
        }

        .cc-stay-summary {
            margin: 10px 0 0;
            padding: 9px 11px;
            border-radius: 10px;
            background: var(--surface);
            font-size: 12px;
            line-height: 1.45;
            color: var(--muted)
        }

        .cc-stay-summary.has-error {
            background: rgba(239, 68, 68, .12);
            color: #ef4444;
            font-weight: 600
        }
    </style>
