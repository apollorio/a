<?php

/**
 * Template: Create Classified — Blank Canvas
 *
 * Blank Canvas (sem theme — padrão apollo-login).
 * Rota virtual: /classifieds/criar/ ou /marketplace/criar/
 * Requer login. Redireciona deslogados para /login/.
 *
 * @package Apollo\Adverts
 */

if (! defined('ABSPATH')) {
    exit;
}

// Segurança: redireciona usuário não autenticado
if (! is_user_logged_in()) {
    wp_safe_redirect(home_url('/login/?redirect_to=' . rawurlencode((string) $_SERVER['REQUEST_URI'])));
    exit;
}

wp_enqueue_style('apollo-adverts-marketplace');
wp_enqueue_script('apollo-adverts-marketplace');

$current_user = wp_get_current_user();
$rest_url     = esc_url(rest_url('apollo/v1/classifieds'));
$nonce        = wp_create_nonce('wp_rest');
$step         = isset($_GET['step']) ? absint($_GET['step']) : 1;

$adverts_v    = defined('APOLLO_ADVERTS_VERSION') ? APOLLO_ADVERTS_VERSION : '1.0.1';
$adverts_base = defined('APOLLO_ADVERTS_URL') ? APOLLO_ADVERTS_URL : plugin_dir_url(__DIR__);

ob_start();
?>
<link rel="stylesheet" href="<?php echo esc_url($adverts_base . 'assets/css/marketplace.css?v=' . $adverts_v); ?>">
<script src="<?php echo esc_url($adverts_base . 'assets/js/marketplace.js?v=' . $adverts_v); ?>" defer></script>
    <style>
        :root {
            --primary: FF9820;
            --bg: #0a0a0a;
            --surface: #111;
            --border: #222;
            --text: #eee;
            --muted: #888
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            font-family: 'Space Grotesk', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px
        }

        .cc-wrap {
            width: 100%;
            max-width: 580px
        }

        .cc-logo {
            text-align: center;
            margin-bottom: 32px
        }

        .cc-logo span {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -1px;
            color: #fff
        }

        .cc-logo span em {
            color: var(--primary);
            font-style: normal
        }

        .cc-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 32px
        }

        .cc-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 6px
        }

        .cc-subtitle {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 24px
        }

        .cc-steps {
            display: flex;
            gap: 6px;
            margin-bottom: 28px
        }

        .cc-step {
            flex: 1;
            height: 4px;
            border-radius: 2px;
            background: var(--border);
            transition: background .3s
        }

        .cc-step.active,
        .cc-step.done {
            background: var(--primary)
        }

        .cc-field {
            margin-bottom: 16px
        }

        .cc-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--muted);
            margin-bottom: 6px
        }

        .cc-input {
            width: 100%;
            padding: 12px 14px;
            background: #0c0c0c;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-size: 15px;
            font-family: inherit;
            resize: vertical
        }

        .cc-input:focus {
            outline: none;
            border-color: var(--primary)
        }

        .cc-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px
        }

        @media(max-width:480px) {
            .cc-row {
                grid-template-columns: 1fr
            }
        }

        .cc-type-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 20px
        }

        .cc-type-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 16px 10px;
            background: #0c0c0c;
            border: 1px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            transition: border-color .2s, color .2s
        }

        .cc-type-btn i {
            font-size: 24px
        }

        .cc-type-btn.selected,
        .cc-type-btn:hover {
            border-color: var(--primary);
            color: var(--primary)
        }

        .cc-actions {
            display: flex;
