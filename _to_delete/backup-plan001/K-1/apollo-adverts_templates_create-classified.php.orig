    <script>
        (function() {
            'use strict';
            var REST = '<?php echo esc_js($rest_url); ?>';
            var NONCE = '<?php echo esc_js($nonce); ?>';
            var selectedType = '';
            var $ = function(id) {
                return document.getElementById(id);
            };
            var steps = [$('ccStep1'), $('ccStep2'), $('ccStep3')];
            var stepDots = [$('ccS1'), $('ccS2'), $('ccS3')];
            var current = 0;

            function showStep(n) {
                steps.forEach(function(s) {
                    s.style.display = 'none';
                });
                steps[n].style.display = '';
                stepDots.forEach(function(d, i) {
                    d.className = 'cc-step' + (i < n ? ' done' : '') + (i === n ? ' active' : '');
                });
                current = n;
            }
            // STEP 1
            var typeBtns = document.querySelectorAll('.cc-type-btn');
            typeBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    typeBtns.forEach(function(b) {
                        b.classList.remove('selected');
                    });
                    btn.classList.add('selected');
                    selectedType = btn.dataset.type;
                    $('ccNext1').disabled = false;
                    var titleMap = {
                        ticket_sell: 'Detalhes do Ingresso',
                        rent_space: 'Detalhes da Hospedagem',
                        general: 'Detalhes do Anúncio'
                    };
                    $('ccStep2Title').textContent = titleMap[selectedType] || 'Detalhes do anúncio';
                    /* Stay rules only make sense for a stay. */
                    $('ccStayWrap').style.display = selectedType === 'rent_space' ? '' : 'none';
                });
            });

            /* ── Regras da estadia ────────────────────────────────────────
               Mirrors the [apollo_classifieds_rent_space] shortcode: presets
               for the common answers, steppers for the rest, and a summary
               that reads the rules back as a sentence. */
            var stayMin = $('cc_min_nights'),
                stayMax = $('cc_max_days'),
                stayFrom = $('cc_avail_start'),
                stayTo = $('cc_avail_end'),
                staySum = $('ccStaySummary');

            function stayNum(el) { return Math.max(0, parseInt(el && el.value, 10) || 0); }

            function stayFmt(iso) {
                var p = String(iso || '').split('-');
                return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : '';
            }

            function stayConflict() {
                return stayNum(stayMax) > 0 && stayNum(stayMin) > 0 && stayNum(stayMax) < stayNum(stayMin);
            }

            function stayBadRange() {
                return !!(stayFrom.value && stayTo.value && stayTo.value < stayFrom.value);
            }

            function stayRender() {
                document.querySelectorAll('.cc-preset').forEach(function(b) {
                    var t = $(b.dataset.target);
                    b.classList.toggle('is-on', !!t && String(stayNum(t)) === b.dataset.value);
                });
                if (stayFrom.value) stayTo.setAttribute('min', stayFrom.value);

                if (stayConflict()) {
                    staySum.textContent = 'O máximo de dias não pode ser menor que o mínimo de noites.';
                    staySum.classList.add('has-error');
                    return;
                }
                if (stayBadRange()) {
                    staySum.textContent = 'A data final não pode ser anterior à data inicial.';
                    staySum.classList.add('has-error');
                    return;
                }
                staySum.classList.remove('has-error');

                var mn = stayNum(stayMin),
                    md = stayNum(stayMax),
                    parts = [];
                parts.push(mn > 0 ? ('Mínimo ' + mn + (mn === 1 ? ' noite' : ' noites')) : 'Sem mínimo de noites');
                parts.push(md > 0 ? ('até ' + md + (md === 1 ? ' dia' : ' dias')) : 'sem limite de dias');
                parts.push(stayFrom.value || stayTo.value ?
                    ('de ' + (stayFmt(stayFrom.value) || '…') + ' a ' + (stayFmt(stayTo.value) || '…')) :
                    'disponível sem data definida');
                staySum.textContent = parts.join(' · ');
            }

            document.querySelectorAll('.cc-preset').forEach(function(b) {
                b.addEventListener('click', function() {
                    var t = $(b.dataset.target);
                    if (!t) return;
                    t.value = b.dataset.value;
                    stayRender();
                });
            });
            document.querySelectorAll('.cc-step-btn').forEach(function(b) {
                b.addEventListener('click', function() {
                    var t = $(b.dataset.target);
                    if (!t) return;
                    t.value = Math.max(0, stayNum(t) + parseInt(b.dataset.step, 10));
                    stayRender();
                });
            });
            [stayMin, stayMax, stayFrom, stayTo].forEach(function(el) {
                if (el) el.addEventListener('input', stayRender);
            });
            stayRender();
            $('ccNext1').addEventListener('click', function() {
                showStep(1);
            });
            // STEP 2
            $('ccBack2').addEventListener('click', function() {
                showStep(0);
            });
            $('ccNext2').addEventListener('click', function() {
                if (!$('cc_title').value.trim()) {
                    $('cc_title').focus();
                    return;
                }
                showStep(2);
            });
            // STEP 3
            $('ccBack3').addEventListener('click', function() {
                showStep(1);
            });
            $('cc_terms').addEventListener('change', function() {
                $('ccPublish').disabled = !this.checked;
            });
            $('ccPublish').addEventListener('click', async function() {
                var btn = this;
                btn.disabled = true;
                btn.innerHTML = 'Publicando...';
                var msg = $('ccMsg');
                msg.style.display = 'none';
                try {
                    var d = {
                        classified_type: selectedType,
                        title: $('cc_title').value.trim(),
                        description: $('cc_desc').value.trim(),
                        currency: 'BRL',
                        negotiable: $('cc_neg').checked ? '1' : '',
                    };
                    var pr = $('cc_price').value;
                    if (pr) d.price = parseFloat(pr);
                    var lc = $('cc_loc').value.trim();
                    if (lc) d.location = lc;
                    var ph = $('cc_phone').value.trim();
                    if (ph) d.contact_phone = ph;
                    var wa = $('cc_wa').value.trim();
                    if (wa) d.contact_whatsapp = wa;
                    if (!d.title) throw new Error('Título obrigatório.');

                    /* Stay rules ride along only for accommodation adverts —
                       they are meaningless on a ticket or a general ad, and
                       posting zeros would overwrite nothing useful anyway.
                       The hostel switch is NOT sent from any frontend form:
                       it is staff-verified in wp-admin (see
                       APOLLO_ADVERTS_ADMIN_ONLY_META). */
                    if (selectedType === 'rent_space') {
                        if (stayConflict()) throw new Error('O máximo de dias não pode ser menor que o mínimo de noites.');
                        if (stayBadRange()) throw new Error('A data final da disponibilidade não pode ser anterior à inicial.');
                        d.min_nights = stayNum(stayMin);
                        d.max_days = stayNum(stayMax);
                        if (stayFrom.value) d.avail_start = stayFrom.value;
                        if (stayTo.value) d.avail_end = stayTo.value;
                    }
                    var r = await fetch(REST, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-WP-Nonce': NONCE
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify(d)
                    });
                    var res = await r.json();
                    if (!r.ok) throw new Error(res.message || 'Erro ao publicar.');
                    msg.className = 'cc-msg ok';
                    msg.textContent = '✓ Anúncio publicado com sucesso!';
                    msg.style.display = '';
                    if (res.permalink) setTimeout(function() {
                        window.location.href = res.permalink;
                    }, 1500);
                } catch (e) {
                    msg.className = 'cc-msg err';
                    msg.textContent = e.message;
                    msg.style.display = '';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ri-check-double-line"></i> Publicar';
                }
            });
        })();
    </script>
<?php
if (function_exists('apollo_render_document_close')) {
    apollo_render_document_close();
} else {
    ?>
</body>

</html>
    <?php
}