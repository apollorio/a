        /* ── Regras da estadia — only rendered for the Hospedagem type.
           Same host-facing model as the [apollo_classifieds_rent_space]
           shortcode (presets + steppers + a plain-language summary), scoped to
           this wizard's cc- prefix. The HOSTEL switch is intentionally NOT
           here: it is staff-verified in wp-admin only. */
        .cc-stay {
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 14px 14px 12px;
            margin: 4px 0 10px
        }

        .cc-stay-legend {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 700;
            color: var(--txt-heading);
            margin-bottom: 10px
        }

