    <!-- ═══════════════════════════════════════════════════════════════
         FEED LAYOUT  — 3-column grid: spacer | main | sidebar
    ═══════════════════════════════════════════════════════════════ -->
    <div class="feed-shell">

        <div class="feed-spacer"></div>

        <!-- ── MAIN COLUMN ── -->
        <div class="feed-main">

            <!-- Tab Bar -->
            <nav class="feed-tabs" role="tablist">
