    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* Init ApolloExplore */
            if (typeof ApolloExplore !== 'undefined') {
                ApolloExplore.init({
                    rest: '<?php echo esc_js(rest_url('apollo/v1/feed')); ?>',
                    nonce: '<?php echo esc_js(wp_create_nonce('wp_rest')); ?>',
                    limit: 280,
                    userId: <?php echo (int) $user_id; ?>
                });
            }
        });
    </script>

<body>

