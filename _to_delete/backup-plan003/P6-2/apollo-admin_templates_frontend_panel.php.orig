                                                    <?php foreach (($field['options'] ?? array()) as $opt_val => $opt_label) : ?>
                                                        <option value="<?php echo esc_attr($opt_val); ?>" <?php selected($value, $opt_val); ?>>
                                                            <?php echo esc_html($opt_label); ?>
