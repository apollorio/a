  "cdn": {
    "url": "https://cdn.apollo.rio.br/v1.0.0/core.js?v=Random.x.1",
    "version": "1.0.0",
    "mandatory": true,
    "load_priority": "high",
    "includes": [
      "apollo-stylesheet",
      "gsap-3.13.0",
