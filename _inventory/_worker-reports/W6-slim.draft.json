      "reveal-up",
      "translate-2.2.4",
      "tracker",
      "logo-morphing"
    ],
    "global_objects": {
      "ApolloTrack": {
        "methods": [
          "event",
          "pageview",
          "eventView"
        ],
        "description": "Analytics tracker"
      },
      "Translate": {
        "version": "2.2.4",
        "methods": [
          "get",
          "has",
          "apply",
          "observe",
          "register",
          "load"
        ],
        "description": "i18n translation system"
      }
    },
    "html_load": "<script src=\"https://cdn.apollo.rio.br/v1.0.0/core.min.js\" fetchpriority=\"high\"></script>",
    "wp_enqueue": {
      "handle": "apollo-cdn",
      "src": "https://cdn.apollo.rio.br/v1.0.0/core.min.js",
      "deps": [],
      "ver": "1.0.0",
      "in_footer": false
    },
    "nav_header_v6": {
      "DESCRIPTION": "Apollo Nav v6 â€” Luxury Minimalist Header. Source of truth: _library/_dev working/_current/header.html",
      "STATUS": "DOCUMENTED â€” 13 PHP template part comment blocks embedded in header.html",
      "php_conversion_notes": "header.html contains extreme inline PHP conversion comments. Any dev can convert to template parts without prior Apollo knowledge.",
      "template_parts_owner": "apollo-templates",
      "template_parts_base_path": "apollo-templates/templates/parts/header/",
      "entry_point_php": "apollo-templates/templates/header.php",
      "wp_hook": "wp_body_open",
      "load_order": "data.php MUST be first script after <body> â€” engine.php depends on window.ApolloNavData",
      "template_parts": [
        {
          "file": "head.php",
          "content": "<head> contents: meta, CDN core.js (wp_enqueue_script blocking fetchpriority=high), CORS shield inline, CSS (extract to nav-v6.css)",
          "wp_functions": [
            "wp_enqueue_script",
            "wp_add_inline_script",
            "wp_enqueue_style",
            "wp_script_add_data"
          ],
          "hooks": [
            "apollo/header/before_head",
            "apollo/header/after_head"
          ]
        },
        {
          "file": "overlay.php",
          "content": "div#aprio-overlay + div.aprio-header-blur â€” zero PHP vars, static. JS controls via .on class.",
          "wp_functions": [],
          "hooks": []
        },
        {
          "file": "nav-engine.php",
          "content": "Inline <script> motor JS dev-verbose: Panel, DM (KEY=apollo-dark-mode), Clock, BurgerArrow, Nav, Renderer, Morphism, NavFX, LazyList, boot()",
          "wp_functions": [
            "wp_enqueue_script OR readfile inline"
          ],
          "CRITICAL": "Use nav-engine.php in SCRIPT_DEBUG mode, engine.php in production. NEVER both simultaneously.",
          "external_file_future": "lib.apollo.rio.br/aprio.v2/header.nav.js",
          "hooks": [
            "apollo/header/before_nav_engine",
            "apollo/header/after_nav_engine"
          ]
        },
        {
          "file": "panel-nav.php",
          "content": "<nav#pn-nav> burger slide-in panel. #nav-list is EMPTY in PHP â€” JS injectAsideToBurger() clones from <aside> on open. DO NOT populate server-side.",
          "wp_functions": [
            "esc_attr_e"
          ],
          "hooks": []
        },
        {
          "file": "panel-activity.php",
          "content": "div#pn-act â€” messages (#msg-list) + notifications (#notif-list). Both empty in PHP, populated by LazyList JS from ApolloNavData.",
          "wp_functions": [
            "esc_attr_e",
            "esc_url",
            "home_url"
          ],
          "rest_sources": [
            "GET apollo/v1/chat/threads (apollo-chat)",
            "GET apollo/v1/notifications (apollo-notif)"
          ],
          "hooks": []
        },
        {
          "file": "panel-apps.php",
          "content": "div#pn-apps bento grid. #bento-apps empty in PHP, populated by Renderer.renderApps() from ApolloNavData.APPS[].",
          "wp_functions": [
            "esc_attr_e",
            "apply_filters"
          ],
          "filter": "apollo/nav/apps",
          "hooks": []
        },
        {
          "file": "panel-profile.php",
          "content": "div#pn-pf user profile panel. #pf-hero + #pf-menu empty in PHP, populated by Renderer.renderProfile() from ApolloNavData.PROFILE.",
          "wp_functions": [
            "wp_get_current_user",
            "get_avatar_url",
            "apply_filters",
            "wp_logout_url",
            "home_url",
            "esc_attr_e"
          ],
          "filter": "apollo/nav/profile",
          "profile_url_pattern": "/id/{user_login}",
          "dm_toggle_id": "dm",
