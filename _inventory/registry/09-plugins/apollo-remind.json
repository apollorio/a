  "channels": {
    "notif": {
      "class": "Apollo\\Remind\\Channels\\NotifChannel",
      "description": "In-app notification via INSERT into apollo_notifications",
      "NOTE": "Should call apollo_create_notification() â€” see divergences"
    },
    "email": {
      "class": "Apollo\\Remind\\Channels\\EmailChannel",
      "description": "Email dispatch via apollo_send_email() or wp_mail() fallback",
      "NOTE": "Should check _apollo_email_prefs â€” see divergences"
    },
    "push": {
      "class": "Apollo\\Remind\\Channels\\PushChannel",
      "description": "Web Push via VAPID (minishlink/web-push or plain HTTP)",
      "storage": "apollo_remind_push_subs"
    },
    "telegram": {
      "class": "Apollo\\Remind\\Channels\\TelegramChannel",
      "description": "Telegram Bot API POST to user's linked chat_id",
      "storage": "apollo_remind_telegram"
    }
  },
