{
    "name": "apollo/apollo-dashboard",
    "description": "Apollo Dashboard — User dashboard and admin panel for the Apollo ecosystem",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Apollo\\Dashboard\\": "src/"
        }
